{
  "job": {
    "content": [
      {
        "reader": {
          "name": "mysqlreader",
          "parameter": {
            "column": [
              "id",
              "product_id",
              "material_id",
              "group_id",
              "ad_name",
              "materail_url"
            ],
            "connection": [
              {
                "jdbcUrl": [
                  "jdbc:mysql://node103:3306/ad?useSSL=false&allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=utf-8"
                ],
                "table": [
                  "ads"
                ]
              }
            ],
            "password": "123456",
            "splitPk": "id",
            "username": "root",
            "where": "1=1"
          }
        },
        "writer": {
          "name": "hdfswriter",
          "parameter": {
            "column": [
              {
                "name": "id",
                "type": "bigint"
              },
              {
                "name": "product_id",
                "type": "bigint"
              },
              {
                "name": "material_id",
                "type": "bigint"
              },
              {
                "name": "group_id",
                "type": "bigint"
              },
              {
                "name": "ad_name",
                "type": "string"
              },
              {
                "name": "materail_url",
                "type": "string"
              }
            ],
            "compress": "gzip",
            "defaultFS": "hdfs://node101:8020",
            "fieldDelimiter": "\t",
            "fileName": "ads",
            "fileType": "text",
            "path": "/origin_data/ad/ads_full/${do_date}",
            "writeMode": "truncate",
            "nullFormat": "\\N"
          }
        }
      }
    ],
    "setting": {
      "speed": {
        "channel": 1
      }
    }
  }
}