{
  "job": {
    "content": [
      {
        "reader": {
          "name": "mysqlreader",
          "parameter": {
            "column": [
              "id",
              "platform",
              "platform_alias_zh"
            ],
            "connection": [
              {
                "jdbcUrl": [
                  "jdbc:mysql://node103:3306/ad?useSSL=false&allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=utf-8"
                ],
                "table": [
                  "platform_info"
                ]
              }
            ],
            "password": "123456",
            "splitPk": "id",
            "username": "root",
            "where": "1=1"
          }
        },
        "writer": {
          "name": "hdfswriter",
          "parameter": {
            "column": [
              {
                "name": "id",
                "type": "string"
              },
              {
                "name": "platform",
                "type": "string"
              },
              {
                "name": "platform_alias_zh",
                "type": "string"
              }
            ],
            "compress": "gzip",
            "defaultFS": "hdfs://node101:8020",
            "fieldDelimiter": "\t",
            "fileName": "platform_info",
            "fileType": "text",
            "path": "/origin_data/ad/platform_info_full/${do_date}",
            "writeMode": "truncate",
            "nullFormat": "\\N"
          }
        }
      }
    ],
    "setting": {
      "speed": {
        "channel": 1
      }
    }
  }
}