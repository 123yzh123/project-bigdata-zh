{
  "job": {
    "setting": {
      "speed": {
        "channel": 1
      }
    },
    "content": [
      {
        "reader": {
          "name": "hdfsreader",
          "parameter": {
            "path": "${exportdir}",
            "defaultFS": "hdfs://node101:8020",
            "column": [
              "*"
            ],
            "fileType": "text",
            "encoding": "UTF-8",
            "fieldDelimiter": "\t",
            "nullFormat": "\\N"
          }
        },
        "writer": {
          "name": "mysqlwriter",
          "parameter": {
            "writeMode": "replace",
            "username": "root",
            "password": "123456",
            "column": [
              "dt",
              "ad_id",
              "ad_name",
              "platform_id",
              "platform_name_zh",
              "traffic_type",
              "impression_count",
              "click_count",
              "click_rate"
            ],
            "connection": [
              {
                "jdbcUrl": "jdbc:mysql://node103:3306/ad_report?useSSL=false&allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=utf-8",
                "table": [
                  "ads_ad_stats_by_platform"
                ]
              }
            ]
          }
        }
      }
    ]
  }
}